// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth ---

enum Ruolo {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String
  ruolo        Ruolo    @default(USER)
  categoryId   String?
  createdAt    DateTime @default(now())

  sessions      Session[]
  workSchedules WorkSchedule[]
  events        Event[]
  tasks         Task[]
  jobs          Job[]
  notes         Note[]
  sales         Sale[]
  setting          Setting?
  unoErpCredential UnoErpCredential?
  category         UserCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manuals          Manual[]
  manualLibrary    UserManualLibrary[]
  dashboardWidgets DashboardWidgetLayout[]

  @@map("users")
}

model UserCategory {
  id   String @id @default(cuid())
  nome String

  users User[]

  @@map("user_categories")
}

// Id = token random generato lato app (32 byte, base64url), usato direttamente come cookie di sessione.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// --- Orario di lavoro (Account) ---

model WorkSchedule {
  id             String @id @default(cuid())
  userId         String
  giornoSettimana Int    // 0 = domenica ... 6 = sabato
  oraInizio      String // "HH:mm"
  oraFine        String // "HH:mm"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_schedules")
}

// --- Dashboard / Calendario ---

enum WidgetType {
  MINI_CALENDARIO
  PROSSIME_ATTIVITA
  PROSSIMI_LAVORI
  NOTE_RAPIDE
  MANUALI_RAPIDI
}

model DashboardWidgetLayout {
  id         String     @id @default(cuid())
  userId     String
  tipoWidget WidgetType
  x          Int
  y          Int
  w          Int
  h          Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipoWidget])
  @@map("dashboard_widget_layouts")
}

enum EventType {
  EVENTO
  ATTIVITA
}

model Event {
  id            String    @id @default(cuid())
  userId        String
  titolo        String
  descrizione   String?
  inizio        DateTime
  fine          DateTime
  tuttoIlGiorno Boolean   @default(false)
  luogo         String?
  tipo          EventType @default(EVENTO)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("events")
}

// --- Attività ---

enum TaskStatus {
  DA_FARE
  IN_CORSO
  COMPLETATO
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  titolo      String
  descrizione String?
  stato       TaskStatus @default(DA_FARE)
  tag         String[]
  scadenza    DateTime?
  oraInizio   String? // "HH:mm" — fascia oraria disponibile per l'esecuzione, nel giorno di `scadenza`
  oraFine     String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

// --- Lavori ---

enum JobOrigine {
  MANUALE
  UNOERP
}

model Job {
  id            String     @id @default(cuid())
  userId        String
  titolo        String
  cliente       String?
  indirizzo     String?
  stato         String     @default("da_pianificare")
  origine       JobOrigine @default(MANUALE)
  unoerpId      String?
  programmatoIl DateTime? // quando è (stato) effettivamente programmato — via UnoERP o a mano
  scadenza      DateTime? // entro quando va completato — indipendente da programmatoIl
  oraInizio     String? // "HH:mm" — fascia oraria disponibile per l'esecuzione
  oraFine       String?
  note          String?
  categoria     String?
  priorita      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unoerpId])
  @@index([userId])
  @@map("jobs")
}

// --- Manuali e guide ---
//
// Ogni manuale ha un proprietario. Un proprietario può marcarlo isPublic per
// proporlo al catalogo condiviso, ma finché un admin non lo APPROVA resta
// visibile solo a lui (moderazioneStato torna IN_ATTESA ad ogni transizione
// false->true di isPublic). Gli altri utenti lo trovano nel catalogo e
// possono aggiungerlo alla propria libreria (UserManualLibrary) senza
// diventarne proprietari.

enum ModerazioneStato {
  IN_ATTESA
  APPROVATO
  RIFIUTATO
}

model Manual {
  id               String           @id @default(cuid())
  ownerId          String
  titolo           String
  marca            String?
  modello          String?
  categoria        String?
  contenuto        String           @db.Text
  allegati         String[] // path relativi su volume Docker locale
  isPublic         Boolean          @default(false)
  moderazioneStato ModerazioneStato @default(IN_ATTESA)
  createdAt        DateTime         @default(now())

  owner   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  library UserManualLibrary[]

  @@index([ownerId])
  @@map("manuals")
}

model UserManualLibrary {
  id       String   @id @default(cuid())
  userId   String
  manualId String
  addedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  manual Manual @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@unique([userId, manualId])
  @@map("user_manual_library")
}

// --- Note ---

model Note {
  id        String   @id @default(cuid())
  userId    String
  titolo    String
  contenuto String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

// --- Vendite ---

model Sale {
  id       String   @id @default(cuid())
  userId   String
  cliente  String
  // Imponibile, IVA esclusa. L'aliquota serve a calcolare separatamente
  // l'IVA e il totale lordo — non è salvata già scorporata nel prezzo.
  prezzo   Float
  aliquota Float
  data     DateTime
  note     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sales")
}

// --- Impostazioni ---

model Setting {
  userId String @id
  tema   String @default("system")
  altre  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// --- Integrazione UnoERP ---
//
// UnoERP non usa refresh token/scadenza: lo scambio Basic-auth restituisce un
// singolo token opaco valido finché l'ERP non lo invalida lato suo. Se scade,
// l'utente deve riconnettersi (username/password non vengono mai salvati).

model UnoErpCredential {
  userId         String    @id
  baseUrl        String
  tokenEncrypted String
  tokenIv        String
  lastAuthAt     DateTime?
  lastSyncAt     DateTime?
  lastSyncStatus String? // success | error | running
  lastSyncCount  Int       @default(0)
  lastSyncError  String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("unoerp_credentials")
}
