# Copiare in .env e adattare per il proprio ambiente.
#
# In produzione (docker-compose.prod.yml sul VPS) l'host del database è il
# nome del servizio Docker `db`, non `localhost`:
#   DATABASE_URL="postgresql://workerp:<password-vera>@db:5432/workerp?schema=public"
# NODE_ENV=production è già impostato da Docker (vedi Dockerfile); non va
# aggiunto qui.

# Postgres (locale via docker-compose, oppure il servizio `db` sul VPS)
DATABASE_URL="postgresql://workerp:workerp@localhost:5433/workerp?schema=public"

# Usate dal servizio `db` in docker-compose.yml
POSTGRES_USER=workerp
POSTGRES_PASSWORD=workerp
POSTGRES_DB=workerp

# Utente iniziale creato da `npx prisma db seed` — va eseguito a mano una
# volta sola dopo il primo deploy (non è nell'entrypoint del container:
# lo rieseguirebbe ad ogni riavvio, sovrascrivendo la password ogni volta):
#   docker compose -f docker-compose.prod.yml exec app npx prisma db seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiami
ADMIN_NOME=Admin

# Integrazione UnoERP — chiave per cifrare il token salvato in DB (genera con
# `openssl rand -hex 32`) e secret condiviso con cui la route /api/unoerp/cron
# si autentica (il cron in produzione la chiama in loopback, vedi instrumentation.ts)
UNOERP_ENCRYPTION_KEY=
UNOERP_CRON_SECRET=

# Notifiche push (Web Push/VAPID) — genera la coppia con:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT è un mailto: o un URL che identifica chi invia le notifiche
# (richiesto dal protocollo, i push service lo usano per contattarti in caso
# di abuso). NOTIFICHE_CRON_SECRET come UNOERP_CRON_SECRET: genera con
# `openssl rand -hex 24`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICHE_CRON_SECRET=

# Email (SMTP proprio) — opzionale: se una di queste manca, le email non
# vengono inviate (solo loggato), nessun errore. Qualunque provider SMTP va
# bene (dominio proprio, un servizio già in uso, ecc.).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
